<?php

namespace {{ namespace }};

use Aldeebhasan\Panorama\Dataset\Dataset;
use Aldeebhasan\Panorama\Dataset\Params;
use Aldeebhasan\Panorama\Schema\Schema;
use Illuminate\Support\Facades\DB;

class {{ class }} extends Dataset
{
    /**
     * The name reports and queries refer to this dataset by.
     */
    public string $name = '{{ datasetName }}';

    /**
     * The filters this dataset accepts. Leave empty to receive them all.
     *
     * @return array<string,mixed>
     */
    public function parameters(): array
    {
        return [
            // 'from' => ['required', 'date'],
        ];
    }

    /**
     * Pull the raw rows from wherever they live: a query builder cursor, an
     * HTTP client, an Eloquent model. Push filters down to the source where
     * it can apply them itself, and return a generator or a cursor rather
     * than an array, so a large source is never held in memory.
     */
    public function fetch(Params $params): iterable
    {
        return DB::table('{{ datasetName }}')
            ->cursor();
    }

    /**
     * The shape every row this dataset yields is guaranteed to have.
     */
    public function schema(): Schema
    {
        return Schema::make()
            ->primaryKey('id')
            ->int('id');
    }
}
